{
  "name": "graphforge-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "build": "pnpm -r --filter '!@curatelabs/graphforge-docs-site' build",
    "test:bdd": "pnpm -r test:bdd",
    "test:agent-skills": "pnpm --filter @curatelabs/graphforge-agent-skills test",
    "smoke:agent-skills": "pnpm --filter @curatelabs/graphforge-agent-skills test:offline",
    "test:node-native": "pnpm --filter @curatelabs/graphforge test",
    "test:node-cli": "pnpm --filter @curatelabs/graphforge-cli test",
    "smoke:node-cli": "pnpm --filter @curatelabs/graphforge-cli test:offline",
    "format:node": "pnpm --filter @curatelabs/graphforge format:check",
    "format:node-cli": "pnpm --filter @curatelabs/graphforge-cli format:check",
    "format:agent-skills": "pnpm --filter @curatelabs/graphforge-agent-skills format:check",
    "docs:dev": "pnpm --filter @curatelabs/graphforge-docs-site dev",
    "docs:build": "pnpm --filter @curatelabs/graphforge-docs-site build",
    "docs:check-links": "pnpm --filter @curatelabs/graphforge-docs-site check-links",
    "docs:test-extension": "node docs-site/scripts/test-extension-docs.mjs",
    "docs:update-extension": "node docs-site/scripts/update-extension-docs.mjs",
    "docs:preview": "pnpm --filter @curatelabs/graphforge-docs-site preview"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "3.9.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
