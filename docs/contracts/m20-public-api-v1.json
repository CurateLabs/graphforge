{
  "format": "graphforge-public-api",
  "api_contract": "graphforge-m20-api/1",
  "canonical_contract": "graphforge-canonical/1",
  "surfaces": {
    "rust_result": "graphforge_exec::ExecutionResult",
    "python_result": "pyarrow.Table",
    "node_result": "Promise<Buffer> (Arrow IPC stream)"
  },
  "page": {
    "default_limit": 100,
    "maximum_limit": 10000,
    "token_metadata_key": "graphforge.next_page_token",
    "snapshot_loss_error": "GF_PAGE_SNAPSHOT_GONE"
  },
  "methods": [
    {
      "rust": "project_capabilities",
      "python": "project_capabilities",
      "node": "projectCapabilities",
      "kind": "read",
      "output_schema": "project_capability@1",
      "order": ["capability_id"]
    },
    {
      "rust": "enable_capability",
      "python": "enable_capability",
      "node": "enableCapability",
      "kind": "write",
      "request": "EnableCapabilityRequest",
      "output_schema": "project_capability@1",
      "idempotency": "required operation_uuid; complete canonical request"
    },
    {
      "rust": "provenance_event",
      "python": "provenance_event",
      "node": "provenanceEvent",
      "kind": "get",
      "key": "provenance_uuid",
      "output_schema": "provenance_event@1"
    },
    {
      "rust": "list_provenance_history",
      "python": "list_provenance_history",
      "node": "listProvenanceHistory",
      "kind": "list",
      "request": "ProvenanceHistoryRequest",
      "output_schema": "provenance_history@1",
      "order": ["recorded_at", "provenance_uuid", "role", "ordinal", "subject_uuid"]
    },
    {
      "rust": "create_assertion",
      "python": "create_assertion",
      "node": "createAssertion",
      "kind": "write",
      "request": "CreateAssertionRequest",
      "output_schema": "assertion@1",
      "idempotency": "required operation_uuid and assertion_uuid; complete canonical request"
    },
    {
      "rust": "assertion",
      "python": "assertion",
      "node": "assertion",
      "kind": "get",
      "key": "assertion_uuid",
      "output_schema": "assertion@1"
    },
    {
      "rust": "list_assertions",
      "python": "list_assertions",
      "node": "listAssertions",
      "kind": "list",
      "request": "ListAssertionsRequest",
      "output_schema": "assertion@1",
      "order": ["recorded_at", "assertion_uuid"]
    },
    {
      "rust": "assertion_graph_refs",
      "python": "assertion_graph_refs",
      "node": "assertionGraphRefs",
      "kind": "list",
      "key": "assertion_uuid",
      "output_schema": "assertion_graph_ref@1",
      "order": ["role", "ordinal", "graph_kind", "graph_uuid"]
    },
    {
      "rust": "assess_confidence",
      "python": "assess_confidence",
      "node": "assessConfidence",
      "kind": "write",
      "request": "AssessConfidenceRequest",
      "output_schema": "confidence_assessment@1",
      "idempotency": "required operation_uuid and confidence_uuid; complete canonical request"
    },
    {
      "rust": "confidence_assessment",
      "python": "confidence_assessment",
      "node": "confidenceAssessment",
      "kind": "get",
      "key": "confidence_uuid",
      "output_schema": "confidence_assessment@1"
    },
    {
      "rust": "list_confidence_assessments",
      "python": "list_confidence_assessments",
      "node": "listConfidenceAssessments",
      "kind": "list",
      "request": "ListConfidenceAssessmentsRequest",
      "output_schema": "confidence_assessment@1",
      "order": ["recorded_at", "confidence_uuid"]
    },
    {
      "rust": "confidence_inputs",
      "python": "confidence_inputs",
      "node": "confidenceInputs",
      "kind": "list",
      "key": "confidence_uuid",
      "output_schema": "confidence_input@1",
      "order": ["ordinal", "input_confidence_uuid"]
    },
    {
      "rust": "attach_evidence",
      "python": "attach_evidence",
      "node": "attachEvidence",
      "kind": "write",
      "request": "AttachEvidenceRequest",
      "output_schema": "evidence_link@1",
      "idempotency": "required operation_uuid and evidence_uuid; complete canonical request"
    },
    {
      "rust": "create_assertion_with_evidence",
      "python": "create_assertion_with_evidence",
      "node": "createAssertionWithEvidence",
      "kind": "write",
      "request": "CreateAssertionWithEvidenceRequest",
      "output_schema": "assertion@1",
      "idempotency": "assertion operation_uuid owns complete assertion and evidence bundle"
    },
    {
      "rust": "evidence_link",
      "python": "evidence_link",
      "node": "evidenceLink",
      "kind": "get",
      "key": "evidence_uuid",
      "output_schema": "evidence_link@1"
    },
    {
      "rust": "list_evidence_links",
      "python": "list_evidence_links",
      "node": "listEvidenceLinks",
      "kind": "list",
      "request": "ListEvidenceLinksRequest",
      "output_schema": "evidence_link@1",
      "order": ["recorded_at", "evidence_uuid"]
    },
    {
      "rust": "invoke_recorded",
      "python": "invoke_recorded",
      "node": "invokeRecorded",
      "kind": "write_and_dispatch",
      "request": "RecordedAlgorithmRequest",
      "output": "RecordedAlgorithmResult",
      "idempotency": "required operation_uuid and run_uuid; canonical descriptor"
    },
    {
      "rust": "algorithm_run",
      "python": "algorithm_run",
      "node": "algorithmRun",
      "kind": "get",
      "key": "run_uuid",
      "output_schema": "algorithm_run@1"
    },
    {
      "rust": "list_algorithm_runs",
      "python": "list_algorithm_runs",
      "node": "listAlgorithmRuns",
      "kind": "list",
      "request": "ListAlgorithmRunsRequest",
      "output_schema": "algorithm_run@1",
      "order": ["started_at", "run_uuid"]
    },
    {
      "rust": "algorithm_run_events",
      "python": "algorithm_run_events",
      "node": "algorithmRunEvents",
      "kind": "list",
      "key": "run_uuid",
      "output_schema": "algorithm_run_event@1",
      "order": ["recorded_at", "event_uuid"]
    }
  ],
  "request_shapes": {
    "WriteContext": ["operation_uuid", "actor_uuid?"],
    "PageRequest": ["limit=100", "after?", "cancellation?"],
    "EnableCapabilityRequest": ["context", "capability_id", "capability_version"],
    "ProvenanceHistoryRequest": ["subject_uuid?", "operation_uuid?", "page"],
    "CreateAssertionRequest": ["context", "assertion_uuid", "claim", "graph_refs[]"],
    "AssertionGraphRefInput": ["graph_uuid", "graph_kind", "role", "ordinal"],
    "ListAssertionsRequest": ["graph_uuid?", "page"],
    "AssessConfidenceRequest": ["context", "confidence_uuid", "assertion_uuid", "policy"],
    "ListConfidenceAssessmentsRequest": ["assertion_uuid?", "page"],
    "AttachEvidenceRequest": ["context", "evidence_uuid", "assertion_uuid", "source_uuid", "source_kind", "role", "weight?"],
    "CreateAssertionWithEvidenceRequest": ["assertion", "evidence[]"],
    "EvidenceInput": ["evidence_uuid", "source_uuid", "source_kind", "role", "weight?"],
    "ListEvidenceLinksRequest": ["assertion_uuid?", "source_uuid?", "page"],
    "RecordedAlgorithmRequest": ["context", "run_uuid", "descriptor", "cancellation?"],
    "ListAlgorithmRunsRequest": ["algorithm?", "page"]
  },
  "schemas": {
