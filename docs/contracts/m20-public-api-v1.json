      ["recorded_at", "Timestamp(Microsecond,UTC)", false],
      ["contract_version", "UInt32", false]
    ],
    "provenance_history@1": [
      ["provenance_uuid", "FixedSizeBinary(16)", false],
      ["operation_uuid", "FixedSizeBinary(16)", false],
      ["event_kind", "Utf8", false],
      ["actor_uuid", "FixedSizeBinary(16)", true],
      ["recorded_at", "Timestamp(Microsecond,UTC)", false],
      ["contract_version", "UInt32", false],
      ["lineage_uuid", "FixedSizeBinary(16)", false],
      ["subject_uuid", "FixedSizeBinary(16)", false],
      ["subject_kind", "Utf8", false],
      ["role", "Utf8", false],
      ["ordinal", "UInt32", false],
      ["lineage_contract_version", "UInt32", false]
    ],
    "assertion@1": [
      ["assertion_uuid", "FixedSizeBinary(16)", false],
      ["claim", "Utf8", false],
      ["provenance_uuid", "FixedSizeBinary(16)", false],
      ["recorded_at", "Timestamp(Microsecond,UTC)", false],
      ["contract_version", "UInt32", false]
    ],
    "assertion_graph_ref@1": [
      ["assertion_uuid", "FixedSizeBinary(16)", false],
      ["graph_uuid", "FixedSizeBinary(16)", false],
      ["graph_kind", "Utf8", false],
      ["role", "Utf8", false],
      ["ordinal", "UInt32", false],
      ["contract_version", "UInt32", false]
    ],
    "confidence_assessment@1": [
      ["confidence_uuid", "FixedSizeBinary(16)", false],
      ["assertion_uuid", "FixedSizeBinary(16)", false],
      ["policy", "Utf8", false],
      ["policy_version", "UInt32", false],
      ["value", "Float64", true],
      ["provenance_uuid", "FixedSizeBinary(16)", false],
      ["recorded_at", "Timestamp(Microsecond,UTC)", false],
      ["contract_version", "UInt32", false]
    ],
    "confidence_input@1": [
      ["confidence_uuid", "FixedSizeBinary(16)", false],
      ["input_confidence_uuid", "FixedSizeBinary(16)", false],
      ["input_value", "Float64", true],
      ["ordinal", "UInt32", false],
      ["contract_version", "UInt32", false]
    ],
    "evidence_link@1": [
      ["evidence_uuid", "FixedSizeBinary(16)", false],
      ["assertion_uuid", "FixedSizeBinary(16)", false],
      ["source_uuid", "FixedSizeBinary(16)", false],
      ["source_kind", "Utf8", false],
      ["role", "Utf8", false],
      ["weight", "Float64", true],
      ["provenance_uuid", "FixedSizeBinary(16)", false],
      ["recorded_at", "Timestamp(Microsecond,UTC)", false],
      ["contract_version", "UInt32", false]
    ],
    "algorithm_run@1": [
      ["run_uuid", "FixedSizeBinary(16)", false],
      ["algorithm", "Utf8", false],
      ["algorithm_version", "UInt32", false],
      ["descriptor_version", "UInt32", false],
      ["descriptor", "Binary", false],
      ["projection_fingerprint", "FixedSizeBinary(32)", false],
      ["provenance_uuid", "FixedSizeBinary(16)", false],
      ["started_at", "Timestamp(Microsecond,UTC)", false],
      ["contract_version", "UInt32", false]
    ],
    "algorithm_run_event@1": [
