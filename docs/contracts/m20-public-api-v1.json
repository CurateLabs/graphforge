      ["support", "Utf8", false],
      ["schema_inventory_sha256", "FixedSizeBinary(32)", true],
      ["generation_uuid", "FixedSizeBinary(16)", false]
    ],
    "provenance_event@1": [
      ["provenance_uuid", "FixedSizeBinary(16)", false],
      ["operation_uuid", "FixedSizeBinary(16)", false],
      ["event_kind", "Utf8", false],
