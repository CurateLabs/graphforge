  "composites": {
    "graph_mutation": ["graph", "provenance_event", "lineage"],
    "enable_capability": ["capability_manifest", "required_initial_participants"],
    "create_assertion": ["assertion", "assertion_graph_refs", "provenance_event", "lineage"],
    "create_assertion_with_evidence": ["assertion", "assertion_graph_refs", "evidence_links", "provenance_event", "lineage"],
    "attach_evidence": ["evidence_link", "provenance_event", "lineage"],
    "assess_confidence": ["confidence_assessment", "confidence_inputs", "provenance_event", "lineage"],
    "run_start": ["algorithm_run", "started_event", "provenance_event", "lineage"],
    "run_terminal": ["terminal_event", "result_fingerprint", "provenance_event", "lineage"]
  },
  "errors": {
    "request": ["GF_VALIDATION", "GF_UNKNOWN_ARGUMENT", "GF_NOT_FOUND"],
    "identity": ["GF_IDEMPOTENCY_CONFLICT", "GF_IDENTITY_CONFLICT", "GF_FINGERPRINT_COLLISION"],
    "capability": ["GF_CAPABILITY_DISABLED", "GF_UNSUPPORTED_CAPABILITY_VERSION"],
    "format": ["GF_UNSUPPORTED_PROJECT_FORMAT", "GF_PROJECT_UNINITIALIZED", "GF_PROJECT_CORRUPT", "GF_SCHEMA_MISMATCH"],
    "transaction": ["GF_WRITER_BUSY", "GF_UNSUPPORTED_FILESYSTEM", "GF_TRANSACTION_FAILED"],
    "control": ["GF_CANCELLED", "GF_RESOURCE_LIMIT"],
    "pagination": ["GF_PAGE_INVALID", "GF_PAGE_SNAPSHOT_GONE"],
    "run": ["GF_RESULT_NOT_RETAINED"],
    "io": ["GF_IO"]
  },
  "removed": [
    "ExecuteOptions.confidence",
    "execute_with_options",
    "python:execute.confidence",
    "node:execute.confidence"
  ],
  "forbidden": [
    "migrate",
    "migrate_project",
    "upgrade_project",
    "import_v04",
    "open_legacy",
    "generation_zero"
  ]
