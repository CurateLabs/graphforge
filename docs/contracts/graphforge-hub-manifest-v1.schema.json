{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphforge.sh/schemas/hub-manifest-v1.json",
  "title": "GraphForge Hub discovery manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "repository", "default_ref", "version", "required_capabilities", "objects"],
  "properties": {
    "protocol": {"const": "graphforge-hub/1"},
    "repository": {"$ref": "#/$defs/repository"},
    "default_ref": {"type": "string", "minLength": 1, "maxLength": 4096},
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "package"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "digest", "object_digest"],
          "properties": {
            "format": {"const": "graphforge-project/2"},
            "digest": {"$ref": "#/$defs/digest"},
            "object_digest": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "major"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 4096},
          "major": {"type": "integer", "minimum": 0, "maximum": 4294967295}
        }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "size", "media_type", "location"],
        "properties": {
          "digest": {"$ref": "#/$defs/digest"},
          "size": {"type": "integer", "minimum": 1},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 4096},
          "location": {"type": "string", "pattern": "^https://", "maxLength": 4096}
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,98}[a-z0-9]$|^[a-z]$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name"],
      "properties": {"owner": {"$ref": "#/$defs/slug"}, "name": {"$ref": "#/$defs/slug"}}
    }
  }
}
