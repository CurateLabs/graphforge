+                        route_fixed_run::<NODE_DETAIL_WIDTH>(
+                            root,
+                            node_plan,
+                            &receipt.details,
+                            Some(detail_codec),
+                            node_details,
+                            cancelled,
+                            evidence,
+                        )
+                    })
+                });
+                let coordinator = route_task(0, &stop, |lane_cancelled, evidence| {
+                    let mut coordinator_cancelled = || {
+                        if cancelled() {
+                            stop.store(true, std::sync::atomic::Ordering::Release);
+                            true
+                        } else {
+                            lane_cancelled()
+                        }
+                    };
