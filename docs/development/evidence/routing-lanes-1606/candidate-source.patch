+                .as_ref()
+                .ok_or_else(|| storage("edge receipt lacks endpoint run"))?;
+            let admitted = lease.lanes().get();
+            let (coordinator, detail, endpoint) = std::thread::scope(|scope| {
+                let route_detail = || {
+                    route_task(2, &stop, |cancelled, evidence| {
+                        route_fixed_run::<EDGE_DETAIL_WIDTH>(
+                            root,
+                            plan,
+                            &receipt.details,
+                            Some(detail_codec),
+                            edge_details,
+                            cancelled,
+                            evidence,
+                        )
+                    })
+                };
+                let reversed = super::lane_jobs_reversed();
+                let (detail, endpoint) = if reversed && admitted >= 2 {
+                    let endpoint = Some(scope.spawn(|| {
+                        route_task(3, &stop, |cancelled, evidence| {
+                            route_fixed_run::<ENDPOINT_WIDTH>(
+                                root,
+                                node_plan,
+                                endpoint_source,
+                                None,
+                                endpoints,
+                                cancelled,
+                                evidence,
+                            )
+                        })
+                    }));
+                    let detail = scope.spawn(route_detail);
+                    (detail, endpoint)
+                } else {
+                    let detail = scope.spawn(route_detail);
+                    let endpoint = (admitted >= 2).then(|| {
+                        scope.spawn(|| {
+                            route_task(3, &stop, |cancelled, evidence| {
+                                route_fixed_run::<ENDPOINT_WIDTH>(
+                                    root,
+                                    node_plan,
+                                    endpoint_source,
+                                    None,
+                                    endpoints,
+                                    cancelled,
+                                    evidence,
+                                )
+                            })
+                        })
+                    });
+                    (detail, endpoint)
+                };
+                let coordinator = route_task(0, &stop, |lane_cancelled, evidence| {
+                    let mut coordinator_cancelled = || {
+                        if cancelled() {
+                            stop.store(true, std::sync::atomic::Ordering::Release);
+                            true
+                        } else {
+                            lane_cancelled()
+                        }
+                    };
+                    route_identity_run(
+                        root,
+                        plan,
+                        receipt,
+                        identities,
+                        &mut coordinator_cancelled,
+                        evidence,
