+            root,
+            plan,
+            node_plan,
+            receipt,
+            detail_codec,
+            identities,
+            node_details,
+            edge_details,
+            endpoints,
+            cancelled,
+            evidence,
+        );
+    };
+
+    let stop = std::sync::atomic::AtomicBool::new(false);
+    let mut jobs = Vec::with_capacity(3);
+    let (coordinator, lane_count) = match receipt.kind {
+        ConstructionChunkKind::Node => {
+            let handle = std::thread::scope(|scope| {
+                let detail = scope.spawn(|| {
