+    cancelled: &mut impl FnMut() -> bool,
+    evidence: &mut GraphConstructionEvidence,
+) -> Result<(), GfError> {
+    let extra_lanes = if receipt.kind == ConstructionChunkKind::Edge {
+        2
+    } else {
+        1
+    };
