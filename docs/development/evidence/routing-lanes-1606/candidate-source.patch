+/// Fold only counters routing tasks can touch. Each addition is checked and
+/// the cache-window high-water mark is combined by max, in logical family
+/// order, after every admitted worker has joined.
+fn fold_routing_tasks(
+    target: &mut GraphConstructionEvidence,
+    mut tasks: Vec<RoutingTaskResult>,
+) -> Result<(), GfError> {
+    tasks.sort_by_key(|task| task.family);
+    let mut first_error_index = None;
+    let mut cancellation_error = None;
+    for task in tasks {
+        let source = task.evidence;
+        target.merge_read_blocks = target
+            .merge_read_blocks
+            .checked_add(source.merge_read_blocks)
+            .ok_or_else(|| storage("merge read block count overflows"))?;
+        target.merge_read_records = target
+            .merge_read_records
+            .checked_add(source.merge_read_records)
+            .ok_or_else(|| storage("merge read record count overflows"))?;
+        target.merge_read_bytes = target
+            .merge_read_bytes
+            .checked_add(source.merge_read_bytes)
+            .ok_or_else(|| storage("merge read byte count overflows"))?;
+        target.merge_read_operations = target
+            .merge_read_operations
+            .checked_add(source.merge_read_operations)
+            .ok_or_else(|| storage("merge read operation count overflows"))?;
+        target.merge_written_records = target
+            .merge_written_records
+            .checked_add(source.merge_written_records)
+            .ok_or_else(|| storage("merge written record count overflows"))?;
+        target.merge_written_bytes = target
+            .merge_written_bytes
+            .checked_add(source.merge_written_bytes)
+            .ok_or_else(|| storage("merge written byte count overflows"))?;
+        target.cache_release_operations = target
+            .cache_release_operations
+            .checked_add(source.cache_release_operations)
+            .ok_or_else(|| storage("cache release operations overflows"))?;
+        target.cache_release_unsupported_operations = target
+            .cache_release_unsupported_operations
+            .checked_add(source.cache_release_unsupported_operations)
+            .ok_or_else(|| storage("unsupported cache release operations overflows"))?;
+        target.cache_released_bytes = target
+            .cache_released_bytes
+            .checked_add(source.cache_released_bytes)
+            .ok_or_else(|| storage("cache released bytes overflows"))?;
+        target.peak_cache_release_window_bytes = target
+            .peak_cache_release_window_bytes
+            .max(source.peak_cache_release_window_bytes);
+        if let Err(error) = task.result {
+            if error.to_string() == "construction cancelled" {
+                cancellation_error.get_or_insert(error);
+            } else if first_error_index.is_none() {
+                first_error_index = Some(error);
+            }
+        }
+    }
+    first_error_index.or(cancellation_error).map_or(Ok(()), Err)
+}
