+/// callback; edge details and endpoints may use the existing construction
+/// admission lanes because their partitioners and source artifacts are
+/// disjoint.
+#[allow(clippy::too_many_arguments)]
+fn route_receipt_families(
+    root: &StableDirectory,
+    plan: &PartitionPlan,
+    node_plan: &PartitionPlan,
+    receipt: &ConstructionChunkReceipt,
