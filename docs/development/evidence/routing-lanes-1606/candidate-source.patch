+#[allow(clippy::too_many_arguments)]
+fn route_receipt_families_sequential(
+    root: &StableDirectory,
+    plan: &PartitionPlan,
+    node_plan: &PartitionPlan,
+    receipt: &ConstructionChunkReceipt,
+    detail_codec: DetailCodec,
+    identities: &mut FixedRangePartitioner<BASE_IDENTITY_WIDTH>,
+    node_details: &mut FixedRangePartitioner<NODE_DETAIL_WIDTH>,
+    edge_details: &mut FixedRangePartitioner<EDGE_DETAIL_WIDTH>,
+    endpoints: &mut FixedRangePartitioner<ENDPOINT_WIDTH>,
+    cancelled: &mut impl FnMut() -> bool,
+    evidence: &mut GraphConstructionEvidence,
+) -> Result<(), GfError> {
+    route_identity_run(root, plan, receipt, identities, cancelled, evidence)?;
+    match receipt.kind {
+        ConstructionChunkKind::Node => route_fixed_run::<NODE_DETAIL_WIDTH>(
+            root,
+            node_plan,
+            &receipt.details,
+            Some(detail_codec),
+            node_details,
+            cancelled,
+            evidence,
+        ),
+        ConstructionChunkKind::Edge => {
+            route_fixed_run::<EDGE_DETAIL_WIDTH>(
+                root,
+                plan,
+                &receipt.details,
+                Some(detail_codec),
+                edge_details,
+                cancelled,
+                evidence,
+            )?;
+            let endpoint_source = receipt
+                .endpoints
+                .as_ref()
+                .ok_or_else(|| storage("edge receipt lacks endpoint run"))?;
+            route_fixed_run::<ENDPOINT_WIDTH>(
+                root,
+                node_plan,
+                endpoint_source,
+                None,
+                endpoints,
+                cancelled,
+                evidence,
+            )
+        }
+    }
+}
+
+struct RoutingTaskResult {
+    family: u8,
+    result: Result<(), GfError>,
+    evidence: GraphConstructionEvidence,
+}
+
+fn route_task(
+    family: u8,
+    stop: &std::sync::atomic::AtomicBool,
+    task: impl FnOnce(&mut dyn FnMut() -> bool, &mut GraphConstructionEvidence) -> Result<(), GfError>,
+) -> RoutingTaskResult {
+    let mut evidence = GraphConstructionEvidence::default();
+    let _region =
+        (family != 0).then(|| crate::concurrency_attribution::RegionScope::named("shape_routing"));
+    let mut cancelled = || stop.load(std::sync::atomic::Ordering::Acquire);
+    let result = task(&mut cancelled, &mut evidence);
+    if result.is_err() {
+        stop.store(true, std::sync::atomic::Ordering::Release);
+    }
+    RoutingTaskResult {
+        family,
+        result,
+        evidence,
+    }
+}
+
+fn join_route_task(
+    handle: std::thread::ScopedJoinHandle<'_, RoutingTaskResult>,
+    family: u8,
+) -> RoutingTaskResult {
+    match handle.join() {
+        Ok(result) => result,
+        Err(_) => RoutingTaskResult {
+            family,
+            result: Err(storage("construction routing worker panicked")),
+            evidence: GraphConstructionEvidence::default(),
+        },
+    }
+}
