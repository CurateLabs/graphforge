{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "git_sha", "image_digest", "provider", "region", "scale", "result", "counts", "phase_peak_rss_bytes", "storage"],
  "properties": {
    "schema": {"const": "graphforge-fly-g500-s20/1"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider": {"const": "fly.io"},
    "region": {"type": "string", "pattern": "^[a-z0-9-]{2,20}$"},
    "scale": {"const": 20},
    "result": {"enum": ["passed", "failed"]},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["generated_edges", "source_edges", "imported_edges"],
      "properties": {
        "generated_edges": {"type": "integer", "minimum": 1},
        "source_edges": {"type": "integer", "minimum": 0},
        "imported_edges": {"type": "integer", "minimum": 0}
      }
    },
    "phase_peak_rss_bytes": {
      "type": "object", "additionalProperties": false,
      "required": ["generate", "ingest", "source_reopen", "one_hop", "two_hop", "export", "verify", "import", "import_reopen"],
      "properties": {
        "generate": {"type": "integer", "minimum": 0},
        "ingest": {"type": "integer", "minimum": 0},
        "source_reopen": {"type": "integer", "minimum": 0},
        "one_hop": {"type": "integer", "minimum": 0},
        "two_hop": {"type": "integer", "minimum": 0},
        "export": {"type": "integer", "minimum": 0},
        "verify": {"type": "integer", "minimum": 0},
        "import": {"type": "integer", "minimum": 0},
        "import_reopen": {"type": "integer", "minimum": 0}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_bytes", "allocated_bytes", "capacity_bytes"],
      "properties": {
        "logical_bytes": {"type": "integer", "minimum": 0},
        "allocated_bytes": {"type": "integer", "minimum": 0},
        "capacity_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
