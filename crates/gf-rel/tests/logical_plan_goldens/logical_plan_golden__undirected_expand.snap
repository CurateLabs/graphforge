---
source: crates/gf-rel/tests/logical_plan_golden.rs
---
Projection: Int64(1) AS one [one:Int64]
  Union []
    Projection: []
      Inner Join: var_1.dst_id = var_2.node_id [dst_id:UInt64, node_id:UInt64]
        Projection: var_1.dst_id [dst_id:UInt64]
          Inner Join: var_0.node_id = var_1.src_id [node_id:UInt64, src_id:UInt64, dst_id:UInt64]
            TableScan: var_0 projection=[node_id], full_filters=[array_has(var_0.type_ids, UInt32(0))] [node_id:UInt64]
            TableScan: var_1 projection=[src_id, dst_id], full_filters=[var_1.rel_type_name = Utf8("IS_FRIEND_OF")] [src_id:UInt64, dst_id:UInt64]
        TableScan: var_2 projection=[node_id], full_filters=[array_has(var_2.type_ids, UInt32(0))] [node_id:UInt64]
    Projection: []
      Inner Join: var_1.src_id = var_2.node_id [src_id:UInt64, node_id:UInt64]
        Projection: var_1.src_id [src_id:UInt64]
          Inner Join: var_0.node_id = var_1.dst_id [node_id:UInt64, src_id:UInt64, dst_id:UInt64]
            TableScan: var_0 projection=[node_id], full_filters=[array_has(var_0.type_ids, UInt32(0))] [node_id:UInt64]
            TableScan: var_1 projection=[src_id, dst_id], full_filters=[var_1.src_id != var_1.dst_id, var_1.rel_type_name = Utf8("IS_FRIEND_OF")] [src_id:UInt64, dst_id:UInt64]
        TableScan: var_2 projection=[node_id], full_filters=[array_has(var_2.type_ids, UInt32(0))] [node_id:UInt64]
