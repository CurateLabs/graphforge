"""Bazel targets for graphforge-cli (#8): lib + build.rs + gf bin + tests.

Lib + build script were first modeled in #7 as a binding link dep; this package
owns the remaining bin/unit/integration surface and closes RT-cli-build-script.
"""

load(
    "//tools/bazel:gf_rust.bzl",
    "gf_cargo_build_script",
    "gf_rust_binary",
    "gf_rust_integration_test",
    "gf_rust_library",
    "gf_rust_test",
)

exports_files(["Cargo.toml"])

package(default_visibility = ["//visibility:public"])

_CLI_DEPS = [
    "@crates//:fs4",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:serde_yaml",
    "@crates//:sha2",
    "@crates//:tempfile",
    "@crates//:ureq",
    "@crates//:url",
    "//crates/graphforge-api:graphforge_api",
    "//crates/graphforge-discovery:graphforge_discovery",
    "//crates/graphforge-storage:graphforge_storage",
]

_CONTRACT_FIXTURES = [
    "//docs/contracts/examples:fixtures",
]

_GEOARROW_FIXTURE = [
    "//tests/contracts:geoarrow-interchange-v1.json",
]

_TEMPORAL_FIXTURE = [
    "//tests/contracts:temporal-interchange-v1.json",
]

_MULTI_ONTOLOGY_FIXTURE = [
    "//tests/contracts:multi-ontology-surface-v1.json",
    "//tests/fixtures/multi-ontology-v1:binding-parity-v1.json",
    "//tests/fixtures/multi-ontology-v1:certification_files",
]

_HUB_FIXTURE = ["//tests/fixtures/hub:artifacts"]

# Skill bundle stays at the workspace root (`//:project_skills_bundle`) so
# `project-skills/` remains a pure distribution tree (#7 packaging contract).
gf_cargo_build_script(
    name = "graphforge_cli_build_script",
    build_script_env = {
        "GRAPHFORGE_PROJECT_SKILLS_MANIFEST": "$(execpath //:project-skills/manifest.json)",
    },
    crate_name = "build_script_build",
    data = [
        "//:project_skills_bundle",
        "//:project-skills/manifest.json",
    ],
    pkg_name = "graphforge-cli",
    version = "0.5.2",
)

gf_rust_library(
    name = "graphforge_cli",
    # Exclude the bin root; library sources only.
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    deps = _CLI_DEPS + [":graphforge_cli_build_script"],
)

gf_rust_test(
    name = "graphforge_cli_test",
    crate = ":graphforge_cli",
    compile_data = _CONTRACT_FIXTURES + _GEOARROW_FIXTURE + _HUB_FIXTURE,
    data = _HUB_FIXTURE,
    rustc_env = {
        "CARGO_MANIFEST_DIR": "crates/graphforge-cli",
    },
    size = "medium",
    deps = _CLI_DEPS,
)

gf_rust_binary(
    name = "gf",
    srcs = ["src/main.rs"],
    deps = _CLI_DEPS + [":graphforge_cli"],
)

gf_rust_binary(
    name = "generate_geoarrow_fixtures",
    srcs = ["examples/generate_geoarrow_fixtures.rs"],
    compile_data = _GEOARROW_FIXTURE,
    rustc_env = {
        "CARGO_MANIFEST_DIR": "crates/graphforge-cli",
    },
    deps = _CLI_DEPS + ["@crates//:parquet"],
)

gf_rust_binary(
    name = "generate_temporal_fixtures",
    srcs = ["examples/generate_temporal_fixtures.rs"],
    compile_data = _TEMPORAL_FIXTURE,
    rustc_env = {
        "CARGO_MANIFEST_DIR": "crates/graphforge-cli",
    },
    deps = _CLI_DEPS + ["@crates//:parquet"],
)

gf_rust_binary(
    name = "generate_hub_fixture",
    srcs = ["examples/generate_hub_fixture.rs"],
    compile_data = _HUB_FIXTURE,
    data = _HUB_FIXTURE,
    rustc_env = {
        "CARGO_MANIFEST_DIR": "crates/graphforge-cli",
    },
    deps = _CLI_DEPS + [":graphforge_cli"],
)

_CLI_TEST_DATA = [":gf"] + _CONTRACT_FIXTURES

_CLI_BIN_ENV = {
    "CARGO_BIN_EXE_gf": "$(rootpath :gf)",
}

gf_rust_integration_test(
    name = "checkpoints",
    srcs = ["tests/checkpoints.rs"],
    crate = ":graphforge_cli",
    data = _CLI_TEST_DATA,
    rustc_env = _CLI_BIN_ENV,
    size = "large",
    timeout = "long",
    deps = _CLI_DEPS,
)

gf_rust_integration_test(
    name = "filesystem_admission",
    srcs = ["tests/filesystem_admission.rs"],
    crate = ":graphforge_cli",
    data = _CLI_TEST_DATA,
    rustc_env = _CLI_BIN_ENV,
    size = "medium",
    deps = _CLI_DEPS,
)

gf_rust_integration_test(
    name = "multi_ontology",
    srcs = ["tests/multi_ontology.rs"],
    crate = ":graphforge_cli",
    compile_data = _MULTI_ONTOLOGY_FIXTURE,
    data = _CLI_TEST_DATA + ["//tests/fixtures/multi-ontology-v1:certification_files"],
    rustc_env = _CLI_BIN_ENV,
    size = "large",
    timeout = "long",
    deps = _CLI_DEPS,
)

gf_rust_integration_test(
    name = "portable",
    srcs = ["tests/portable.rs"],
    crate = ":graphforge_cli",
    data = _CLI_TEST_DATA,
    rustc_env = _CLI_BIN_ENV,
    size = "large",
    timeout = "long",
    deps = _CLI_DEPS,
)

gf_rust_integration_test(
    name = "repository",
    srcs = ["tests/repository.rs"],
    crate = ":graphforge_cli",
    compile_data = _CONTRACT_FIXTURES,
    data = _CLI_TEST_DATA,
    rustc_env = _CLI_BIN_ENV,
    size = "large",
    timeout = "long",
    deps = _CLI_DEPS,
)

test_suite(
    name = "cli_tests",
    tests = [
        ":checkpoints",
        ":filesystem_admission",
        ":graphforge_cli_test",
        ":multi_ontology",
        ":portable",
        ":repository",
    ],
)
