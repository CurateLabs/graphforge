---
source: crates/graphforge-exec/tests/explain_snapshots.rs
---
ProjectionExec: expr=[name@0 as bn]
  HashJoinExec: mode=CollectLeft, join_type=Right, on=[(node_uuid@0, node_uuid@0)], projection=[name@1]
    PropertyOverlayExec: route=_untyped
    FilterExec: array_has(type_ids@1, 1073741824), projection=[node_uuid@0]
      RepartitionExec: partitioning=RoundRobinBatch(<N>), input_partitions=1
        ProjectionExec: expr=[node_uuid@9 as node_uuid, type_ids@12 as type_ids]
          ExpandExec: rel=KNOWS, dir=->, adjacency=hit, identity=legacy, fetch=all, demand_batch=all, projection=2, cancel=none
            HashJoinExec: mode=CollectLeft, join_type=Right, on=[(node_uuid@0, node_uuid@0)], projection=[node_id@2]
              PropertyOverlayExec: route=_untyped
              FilterExec: array_has(type_ids@2, 1073741824), projection=[node_uuid@0, node_id@1]
                RepartitionExec: partitioning=RoundRobinBatch(<N>), input_partitions=1
                  OrderedPartitionStreamExec: input_partitions=3
                    GraphForgeParquetExec: fragments=3, batch_size=8192, limit=none
