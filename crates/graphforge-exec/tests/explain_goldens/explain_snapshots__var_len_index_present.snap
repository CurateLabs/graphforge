---
source: crates/graphforge-exec/tests/explain_snapshots.rs
---
ProjectionExec: expr=[1 as one]
  FilterExec: array_has(type_ids@0, 1073741824)
    RepartitionExec: partitioning=RoundRobinBatch(<N>), input_partitions=1
      ProjectionExec: expr=[type_ids@10 as type_ids]
        VarLenExpandExec: rel=KNOWS, hops=1..2, adjacency=hit
          HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(node_uuid@0, node_uuid@0)], projection=[node_uuid@0, node_id@1, type_id@2, type_ids@3, created_at@4, updated_at@5, name@7]
            UuidBuildKeyTapExec: column=0
              CoalescePartitionsExec
                FilterExec: array_has(type_ids@3, 1073741824)
                  OrderedPartitionStreamExec: input_partitions=3
                    GraphForgeParquetExec: fragments=3, batch_size=8192, limit=none
            FilterExec: name@1 = Alice
              PropertyOverlayExec: route=_untyped, equality=name=Str("Alice")
