"""Bazel targets for graphforge-ontology (#10 foundation + #8 integration)."""

load(
    "//tools/bazel:gf_rust.bzl",
    "gf_rust_doc_test",
    "gf_rust_integration_test",
    "gf_rust_library",
    "gf_rust_test",
)

exports_files(["Cargo.toml"])

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "test_fixtures",
    srcs = glob(
        ["tests/fixtures/**/*"],
        exclude = ["**/BUILD.bazel"],
    ),
)

gf_rust_library(
    name = "graphforge_ontology",
    deps = [
        "//crates/graphforge-core:graphforge_core",
    ],
)

gf_rust_test(
    name = "graphforge_ontology_test",
    crate = ":graphforge_ontology",
    deps = [
        "//crates/graphforge-core:graphforge_core",
    ],
)

gf_rust_doc_test(
    name = "graphforge_ontology_doc_test",
    crate = ":graphforge_ontology",
    deps = [
        "//crates/graphforge-core:graphforge_core",
    ],
)

gf_rust_integration_test(
    name = "integration",
    srcs = ["tests/integration.rs"],
    crate = ":graphforge_ontology",
    data = [":test_fixtures"],
    deps = [
        "//crates/graphforge-core:graphforge_core",
    ],
)

test_suite(
    name = "ontology_tests",
    tests = [
        ":graphforge_ontology_doc_test",
        ":graphforge_ontology_test",
        ":integration",
    ],
)
