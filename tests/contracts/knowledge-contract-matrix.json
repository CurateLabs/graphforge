{
  "schema_version": 1,
  "gate": "knowledge",
  "command_groups": {
    "rust": [
      "cargo test -p graphforge-storage --no-fail-fast",
      "cargo test -p graphforge-provenance --no-fail-fast",
      "cargo test -p graphforge-knowledge --no-fail-fast",
      "cargo test -p graphforge-api --lib --no-fail-fast",
      "cargo test -p graphforge-api --test knowledge_isolation --no-fail-fast"
    ]
  },
  "cases": [
    {
      "id": "graph-only-no-knowledge",
      "criterion": "A graph-only project exposes only graph capability and resolves without opening knowledge participants.",
      "command_groups": [
        "rust"
      ],
      "surfaces": [
        "rust"
      ],
      "tests": [
        {
          "kind": "rust",
          "path": "crates/graphforge-api/src/capabilities.rs",
          "symbol": "initial_project_reports_mandatory_graph_and_workspace_capabilities"
        },
        {
          "kind": "rust",
          "path": "crates/graphforge-storage/src/project_generation.rs",
          "symbol": "resolution_does_not_open_unrequested_participant_tables"
        }
      ]
    },
    {
      "id": "knowledge-enabled-empty",
      "criterion": "Enabling knowledge publishes a complete empty capability atomically and survives reopen.",
      "command_groups": [
        "rust"
      ],
      "surfaces": [
        "rust"
      ],
      "tests": [
        {
          "kind": "rust",
          "path": "crates/graphforge-api/src/capabilities.rs",
          "symbol": "enabled_capability_is_selected_after_persistent_reopen"
        }
      ]
    },
    {
