        "--nocapture"
      ]
    },
    {
      "id": "python-bulk-acceptance",
      "surface": "python",
      "argv": ["python", "crates/graphforge-bindings-py/tests/bulk_construction.py"]
    },
    {
      "id": "node-bulk-acceptance",
      "surface": "node",
      "argv": [
        "pnpm",
        "--filter",
        "@curatelabs/graphforge",
        "exec",
        "node",
        "--test",
        "tests/bulk_construction.test.mjs"
      ]
    },
    {
      "id": "cross-binding-bulk-parity",
      "surface": "python",
      "argv": ["python", "scripts/ci/bulk-construction-parity.py"]
