{
  "schema_version": 1,
  "gate": "M20",
  "command_groups": {
    "rust": [
      "cargo test -p graphforge-storage --no-fail-fast",
      "cargo test -p graphforge-provenance --no-fail-fast",
      "cargo test -p graphforge-knowledge --no-fail-fast",
      "cargo test -p graphforge-api --lib --no-fail-fast",
      "cargo test -p graphforge-api --test knowledge_isolation --no-fail-fast"
    ],
    "python": [
      "uvx maturin build --manifest-path crates/graphforge-bindings-py/Cargo.toml --profile dev --out dist/m20",
      "uv venv /tmp/gf-m20-python --python 3.13",
      "uv pip install --python /tmp/gf-m20-python/bin/python dist/m20/*.whl pyarrow",
      "/tmp/gf-m20-python/bin/python crates/graphforge-bindings-py/tests/smoke.py",
      "/tmp/gf-m20-python/bin/python -c \"import runpy; m=runpy.run_path('crates/graphforge-bindings-py/tests/test_invocation_descriptor.py'); m['test_rank_descriptor_golden_and_dispatch']()\""
    ],
    "node": [
      "pnpm install --frozen-lockfile",
      "pnpm --filter @curatelabs/graphforge exec napi build --platform",
      "pnpm --filter @curatelabs/graphforge test:smoke",
      "pnpm --filter @curatelabs/graphforge test"
    ]
  },
  "cases": [
