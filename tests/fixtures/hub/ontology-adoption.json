    }
  },
  "start_from": {
    "argv": ["gf", "--json", "project", "new", "{project}", "--from-ontology", "opendata/openalex", "--ontology-id", "{ontology_id}", "--version", "{version}", "--digest", "{digest}"],
    "output_contract": "graphforge-project-from-ontology/1"
  }
