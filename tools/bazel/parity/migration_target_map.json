    {
      "id": "RT-codspeed-bench",
      "tool": "cargo codspeed / divan benches",
      "status": "justified",
      "justification": "Benchmarks are a Cargo diagnostics surface measured by the CodSpeed workflow, not compiled or tested by //:ci_rust_tests; modeling them in Bazel would add a benchmark toolchain with no correctness signal"
