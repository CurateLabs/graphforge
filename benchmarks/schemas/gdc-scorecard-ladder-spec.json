{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "graphforge-gdc-scorecard-ladder-spec-schema/1",
  "title": "GDC scorecard ladder spec",
  "description": "What the rung runner needs to climb one suite's scorecard ladder: the identity profile to acquire from, the count ladder, and per rung the query workload, the queries refused at mapping, the pinned reference and the variances the card carries. Paths are relative to profile_root, itself relative to the benchmarks root.",
  "type": "object",
  "properties": {
    "schema": { "const": "graphforge-gdc-scorecard-ladder-spec/1" },
    "suite_id": { "enum": ["graphalytics", "snb-bi", "snb-interactive", "finbench-transaction"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 600 },
    "profile_root": { "$ref": "#/$defs/relativePath" },
    "identity_profile": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,40}$" },
    "counts_ladder": { "$ref": "#/$defs/relativePath" },
    "metric_shape": { "enum": ["queries", "graphalytics"] },
    "variance_line": { "type": "string", "minLength": 1, "maxLength": 200 },
    "attribution": { "type": "string", "minLength": 1, "maxLength": 400 },
    "variances": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/variance" } },
    "rungs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "oneOf": [{ "$ref": "#/$defs/rung" }, { "$ref": "#/$defs/unpinnedRung" }] }
    }
  },
  "required": [
    "schema",
    "suite_id",
    "description",
    "profile_root",
    "identity_profile",
    "counts_ladder",
    "metric_shape",
    "variance_line",
    "attribution",
    "variances",
    "rungs"
  ],
  "additionalProperties": false,
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(\\.|[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*)$"
    },
    "variance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["rewrite", "spec_variance", "reference_reading", "discrepancy", "scope"]
        },
        "subject": { "type": "string", "minLength": 1, "maxLength": 120 },
        "text": { "type": "string", "minLength": 1, "maxLength": 800 }
      },
      "required": ["kind", "subject", "text"],
      "additionalProperties": false
    },
    "workloadBuilder": {
      "description": "A workload built at rung time from pinned LDBC parameters: the first per_variant rows of each parameter file (graphforge_bench.gdc_snb_scorecard), or, for finbench-transaction, every published binding (graphforge_bench.gdc_finbench_transaction_scorecard). Interactive short reads take their ids from the validation stream acquired with the dataset.",
      "type": "object",
      "properties": {
        "builder": { "enum": ["snb-bi", "snb-interactive", "finbench-transaction"] },
        "queries": { "$ref": "#/$defs/relativePath" },
        "parameters": {
          "type": "object",
          "properties": {
            "dataset_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
            "path": { "$ref": "#/$defs/relativePath" }
          },
          "required": ["dataset_id", "path"],
          "additionalProperties": false
        },
        "short_reads": {
          "type": "object",
          "properties": {
            "workload_key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,40}$" },
            "path": { "$ref": "#/$defs/relativePath" }
          },
          "required": ["workload_key", "path"],
          "additionalProperties": false
        },
        "per_variant": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "required": ["builder", "queries", "parameters"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "builder": { "const": "snb-interactive" } } },
          "then": { "required": ["short_reads", "per_variant"] }
        },
        {
          "if": { "properties": { "builder": { "const": "snb-bi" } } },
          "then": { "required": ["per_variant"], "not": { "required": ["short_reads"] } }
        },
        {
          "if": { "properties": { "builder": { "const": "finbench-transaction" } } },
          "then": { "not": { "anyOf": [{ "required": ["short_reads"] }, { "required": ["per_variant"] }] } }
        }
      ]
    },
    "unpinnedRung": {
      "description": "A rung of the suite's declared ladder whose dataset is not pinned. The ladder records it as not_admitted (rung_not_pinned) and keeps climbing when a later rung is pinned; the card lists it.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "not_pinned": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "required": ["id", "label", "not_pinned"],
      "additionalProperties": false
    },
    "refusal": {
      "type": "object",
      "properties": {
        "query_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
        "cause": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,80}$" }
      },
      "required": ["query_id", "cause"],
      "additionalProperties": false
    },
    "rung": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "dataset_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
        "input_subdir": {
          "oneOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }]
        },
        "workload": {
          "oneOf": [{ "$ref": "#/$defs/relativePath" }, { "$ref": "#/$defs/workloadBuilder" }]
        },
        "refused": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/refusal" } },
        "reference": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "path": { "$ref": "#/$defs/relativePath" }
              },
              "required": ["path"],
              "additionalProperties": false
            },
            {
              "description": "Derived at check time from the reference outputs the acquired archive ships (Graphalytics).",
              "type": "object",
              "properties": {
                "archive_outputs": { "const": "graphalytics" }
              },
              "required": ["archive_outputs"],
              "additionalProperties": false
            },
            {
              "description": "A complete reference file in the dataset cache, not the repository, pinned by its SHA-256 (graphforge_bench.gdc_finbench_transaction_reference). cache_path is relative to the dataset cache root.",
              "type": "object",
              "properties": {
                "cache_path": { "$ref": "#/$defs/relativePath" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              },
              "required": ["cache_path", "sha256"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "builder": { "const": "snb-bi-umbra" },
                "workload_key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,40}$" },
                "path": { "$ref": "#/$defs/relativePath" },
                "source": { "type": "string", "minLength": 1, "maxLength": 200 }
              },
              "required": ["builder", "workload_key", "path", "source"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": { "builder": { "const": "snb-interactive-spec-derived" } },
              "required": ["builder"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "reference_note": { "type": "string", "minLength": 1, "maxLength": 200 },
        "variances": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/variance" } }
      },
      "required": [
        "id",
        "label",
        "dataset_id",
        "input_subdir",
        "workload",
        "refused",
        "reference",
        "variances"
      ],
      "additionalProperties": false,
      "if": { "properties": { "reference": { "type": "null" } } },
      "then": { "required": ["reference_note"] }
    }
  }
}
