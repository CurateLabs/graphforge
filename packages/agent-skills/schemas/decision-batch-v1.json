{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphforge.dev/schemas/decision-batch-v1.json",
  "title": "GraphForge provider-neutral decision batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "producer", "questions", "results"],
  "properties": {
    "input": { "$ref": "#/$defs/input" },
    "producer": { "$ref": "#/$defs/producer" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/question" }
    },
    "results": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 256 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_uuid", "projection_sha256", "selection_sha256", "selected_item_uuids"],
      "properties": {
        "generation_uuid": { "$ref": "#/$defs/uuid" },
        "version_uuid": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "projection_sha256": { "$ref": "#/$defs/digest" },
        "selection_sha256": { "$ref": "#/$defs/digest" },
        "selected_item_uuids": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/label" },
        "model": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
        "revision": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_uuid", "text", "item_uuids", "kind"],
      "properties": {
        "question_uuid": { "$ref": "#/$defs/uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "item_uuids": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/uuid" } },
        "kind": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "allowed_choices"],
              "properties": {
                "kind": { "const": "choice" },
                "allowed_choices": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/label" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ordered_levels"],
              "properties": {
                "kind": { "const": "rubric_score" },
                "ordered_levels": { "type": "array", "minItems": 2, "maxItems": 256, "items": { "$ref": "#/$defs/label" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "yes_no_probability" } }
            }
          ]
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "minimum", "maximum", "domain", "meaning"],
      "properties": {
        "value": { "type": "number" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "domain": { "$ref": "#/$defs/label" },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_uuid", "status"],
      "properties": {
        "question_uuid": { "$ref": "#/$defs/uuid" },
        "item_uuid": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "status": { "enum": ["answered", "uncertain", "unavailable", "missing"] },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": { "kind": { "const": "choice" }, "value": { "$ref": "#/$defs/label" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": { "kind": { "const": "rubric_score" }, "value": { "$ref": "#/$defs/label" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "yes_no_probability" },
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["yes_probability"],
                  "properties": {
                    "yes_probability": { "type": "number", "minimum": 0, "maximum": 1 },
                    "no_probability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
                  }
                }
              }
            }
          ]
        },
        "confidence": { "anyOf": [{ "$ref": "#/$defs/confidence" }, { "type": "null" }] }
      }
    }
  }
}
