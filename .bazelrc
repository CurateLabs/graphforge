# GraphForge Bazel bootstrap (#11). Blacksmith injects repository remote cache;
# do not set --remote_cache here or in CI.
common --enable_bzlmod
common --noenable_workspace

build --incompatible_strict_action_env
build --experimental_convenience_symlinks=normal

# Keep action logs useful without leaking secrets into cacheable outputs.
build --announce_rc
test --test_output=errors

# CI must not silently update MODULE.bazel.lock.
common:ci --lockfile_mode=error

# The authoritative test build uses --config=correctness, which is a distinct
# configuration nothing else populates, so it reused only 34 of 2273 actions
# from the injected remote cache and rebuilt every dependency. A disk cache on a
# persistent volume gives that configuration cross-run reuse. Bounded so the
# volume cannot grow without limit; entries are content-addressed, so a stale
# entry is simply never read.
build:ci --disk_cache=%workspace%/.bazel-disk-cache
build:ci --experimental_disk_cache_gc_max_size=40G

# Production-sized correctness fixtures need optimized runtime dependencies, but
# must retain Rust's debug assertions and checked arithmetic.
build:correctness --compilation_mode=opt
build:correctness --@rules_rust//rust/settings:extra_rustc_flags=-Cdebug-assertions=yes,-Coverflow-checks=yes
